{
  "editor.codeActionsOnSave": {
    "source.fixAll.stylelint": "explicit"
  },

  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  "search.exclude": {
    "**/node_modules": true,
    "**/build": true,
    "**/.plasmo": true,
    "**/dist": true,
    "**/.next": true,
    "**/out": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/build/**": true,
    "**/.plasmo/**": true,
    "**/dist/**": true
  },

  "eslint.workingDirectories": [{ "mode": "auto" }]
}
