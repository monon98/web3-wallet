{
  "name": "web3-wallet",
  "displayName": "Web3 wallet",
  "version": "0.0.1",
  "description": "A basic Plasmo extension.",
  "author": "monon98",
  "engines": {
    "node": ">=20"
  },
  "targets": {
    "default": {
      "engines": {
        "browsers": "last 2 Chrome versions, not dead"
      }
    }
  },
  "scripts": {
    "dev": "plasmo dev",
    "typecheck": "tsc --noEmit",
    "build": "plasmo build",
    "package": "plasmo package",
    "format": "prettier --write \"**/*.{js,cjs,mjs,jsx,ts,tsx,vue,css,html,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,jsx,ts,tsx,vue,css,html,json,md,yml,yaml}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"**/*.{css,vue}\"",
    "stylelint:fix": "stylelint \"**/*.{css,vue}\" --fix"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@plugin/shared": "workspace:*",
    "@plugin/ui": "workspace:*",
    "@scure/bip32": "^2.0.1",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^7.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tronweb": "^6.5.1",
    "viem": "2.47.6"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "22.10.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@unocss/postcss": "^66.6.7",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.0",
    "eslint-plugin-unicorn": "^56.0.0",
    "globals": "16.4.0",
    "plasmo": "0.90.5",
    "postcss": "^8.5.31",
    "prettier": "3.8.1",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "unocss": "^66.6.7"
  },
  "manifest": {
    "web_accessible_resources": [
      {
        "resources": [
          "tabs/*"
        ],
        "matches": [
          "http://localhost/*",
          "http://127.0.0.1/*",
          "https://localhost/*",
          "https://127.0.0.1/*",
          "http://localhost:3000/*",
          "https://localhost:3000/*",
          "http://localhost:3456/*",
          "https://localhost:3456/*",
          "http://localhost:4173/*",
          "https://localhost:4173/*",
          "http://localhost:4321/*",
          "https://localhost:4321/*",
          "http://localhost:5000/*",
          "https://localhost:5000/*",
          "http://localhost:5173/*",
          "https://localhost:5173/*",
          "http://localhost:8080/*",
          "https://localhost:8080/*",
          "http://localhost:8888/*",
          "https://localhost:8888/*",
          "http://127.0.0.1:3000/*",
          "https://127.0.0.1:3000/*",
          "http://127.0.0.1:3456/*",
          "https://127.0.0.1:3456/*",
          "http://127.0.0.1:4173/*",
          "https://127.0.0.1:4173/*",
          "http://127.0.0.1:4321/*",
          "https://127.0.0.1:4321/*",
          "http://127.0.0.1:5000/*",
          "https://127.0.0.1:5000/*",
          "http://127.0.0.1:5173/*",
          "https://127.0.0.1:5173/*",
          "http://127.0.0.1:8080/*",
          "https://127.0.0.1:8080/*",
          "http://127.0.0.1:8888/*",
          "https://127.0.0.1:8888/*"
        ]
      }
    ],
    "host_permissions": [
      "https://*/*",
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://localhost/*",
      "https://127.0.0.1/*",
      "http://localhost:3000/*",
      "https://localhost:3000/*",
      "http://localhost:3456/*",
      "https://localhost:3456/*",
      "http://localhost:4173/*",
      "https://localhost:4173/*",
      "http://localhost:4321/*",
      "https://localhost:4321/*",
      "http://localhost:5000/*",
      "https://localhost:5000/*",
      "http://localhost:5173/*",
      "https://localhost:5173/*",
      "http://localhost:8080/*",
      "https://localhost:8080/*",
      "http://localhost:8888/*",
      "https://localhost:8888/*",
      "http://127.0.0.1:3000/*",
      "https://127.0.0.1:3000/*",
      "http://127.0.0.1:3456/*",
      "https://127.0.0.1:3456/*",
      "http://127.0.0.1:4173/*",
      "https://127.0.0.1:4173/*",
      "http://127.0.0.1:4321/*",
      "https://127.0.0.1:4321/*",
      "http://127.0.0.1:5000/*",
      "https://127.0.0.1:5000/*",
      "http://127.0.0.1:5173/*",
      "https://127.0.0.1:5173/*",
      "http://127.0.0.1:8080/*",
      "https://127.0.0.1:8080/*",
      "http://127.0.0.1:8888/*",
      "https://127.0.0.1:8888/*"
    ],
    "permissions": [
      "contextMenus",
      "sidePanel",
      "storage",
      "tabs",
      "webNavigation",
      "windows"
    ]
  }
}
