    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@unocss/postcss": "66.6.7",
    "@unocss/reset": "66.6.7",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
