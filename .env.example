# 技术方案 §5.4 环境变量示例（复制为 .env 后填写；勿提交真实密钥）

# --- Web（Next 等，前缀以框架为准）---
NEXT_PUBLIC_CHAIN_ID=1
# 可选：浏览器侧只读 RPC；多数只读请求建议走服务端代理
NEXT_PUBLIC_RPC_URL=https://eth.llamarpc.com
# 可选：覆盖 Fastify 基址；Next 开发模式未设置时默认 http://localhost:8787
NEXT_PUBLIC_API_URL=http://localhost:8787

# --- 服务端 ---
# 开发态 OpenAPI JSON + Swagger UI（/documentation、/documentation/json）；production 不注册；本地可显式关闭
# SERVER_SWAGGER=0
SERVER_PORT=8787
# 默认仅本机（单行 listening）；局域网 / 容器内需监听全部接口时改为 0.0.0.0
SERVER_HOST=127.0.0.1
# SERVER_HOST=0.0.0.0
# 日志：trace | debug | info | warn | error | fatal（默认生产 info、开发 debug）
# LOG_LEVEL=debug
# 是否使用 pino-pretty（1/true 强制开，0/false 强制关；未设置时非 production 默认开）
# LOG_PRETTY=1
# 文件日志：相对运行目录（pnpm dev:server 一般为 apps/server）；默认写入 logs/server.log；设为 0 关闭
# LOG_TO_FILE=0
# LOG_FILE=logs/server.log
# EVM JSON-RPC（链上读/写代理，见 POST /api/v1/evm/rpc；Etherscan 不可达时也用于原生余额兜底）
# 需与查询的 chainId 一致（服务端会用 eth_chainId 校验）；可换成自建节点或其它公共 RPC
# 交易广播 POST /api/v1/tx/broadcast 也依赖该 RPC，并要求 raw tx 的 chainId 与之一致
SERVER_RPC_URL=https://ethereum-rpc.publicnode.com
# Etherscan API V2：https://docs.etherscan.io/introduction
ETHERSCAN_API_KEY=
# 可选；PRO 端点 addresstokenbalance 约 2 次/秒，批量地址串行请求时的间隔（毫秒），默认 550
# ETHERSCAN_PRO_MIN_INTERVAL_MS=550
# 可选；默认 https://api.etherscan.io/v2/api
# 生产环境可指向自建 / 受控代理（解决网络不可达），服务端仍按同名响应解析
# ETHERSCAN_API_URL=https://api.etherscan.io/v2/api
# ERC-20 持仓缓存（毫秒）：新鲜期默认 60s；上游失败时可在过期保留期内回退 stale
# ETHERSCAN_TOKEN_CACHE_TTL_MS=60000
# ETHERSCAN_TOKEN_STALE_TTL_MS=1800000
# 预留：生产化持久化 / Cookie 会话或第三方登录时使用；当前 Bearer 会话为进程内随机 token，不读取该变量
SESSION_SECRET=replace-with-long-random-secret

# 各 chainId 下合约地址（JSON 或按部署方式拆分多键）
# CONTRACT_ADDRESSES_JSON={"1":{"MyContract":"0x0000000000000000000000000000000000000000"}}

# 链上只读批量余额：`packages/contracts/src/evm/BalanceBatchReader.sol`（`BalanceBatchReader`）部署地址（键为十进制 chainId）
# POST /api/v1/evm/balance-reader/query 依赖 SERVER_RPC_URL 与本 JSON
# EVM_BALANCE_READER_ADDRESSES_JSON={"1":"0x0000000000000000000000000000000000000000","11155111":"0x..."}

# 链上批量转账：`packages/contracts/src/evm/BatchSender.sol`（`BatchSender`）部署地址（键为十进制 chainId）
# POST /api/v1/evm/batch-sender/build 会返回 calldata 与 value（由扩展/前端签名）；广播可用 /api/v1/tx/broadcast 或 /api/v1/evm/rpc
# EVM_BATCH_SENDER_ADDRESSES_JSON={"1":"0x0000000000000000000000000000000000000000","11155111":"0x..."}

# Tron（TronGrid）：服务端 Tron 网关数据源；无 API Key 时公共额度很低，建议申请
# https://developers.tron.network/
# SERVER_TRON_API_URL=https://api.trongrid.io
# SERVER_TRON_API_KEY=
# 可选；批量地址查询按地址串行请求的间隔（毫秒），默认 250（无 API Key 时建议调大）
# SERVER_TRON_MIN_INTERVAL_MS=250

# BTC（Esplora）：服务端 BTC 网关数据源；默认 Blockstream 公共实例（无需 Key，公共额度有限）
# https://github.com/Blockstream/esplora/blob/master/API.md
# SERVER_BTC_API_URL=https://blockstream.info/api
# 可选；批量地址查询按地址串行请求的间隔（毫秒），默认 250
# SERVER_BTC_MIN_INTERVAL_MS=250

# 统一多链余额查询（POST /api/v1/balances/query）
# 结果缓存：新鲜期默认 15s；上游失败时可在过期保留期内回退 stale
# SERVER_BALANCE_CACHE_TTL_MS=15000
# SERVER_BALANCE_STALE_TTL_MS=300000
# 限流（固定 60s 窗口，按 IP / 登录会话）：匿名默认 30 次/分钟，登录默认 120 次/分钟
# SERVER_BALANCE_RATE_LIMIT_PER_MINUTE=30
# SERVER_BALANCE_AUTH_RATE_LIMIT_PER_MINUTE=120
